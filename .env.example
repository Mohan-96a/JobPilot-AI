# Environment variables for JobPilot AI

# --- Database Configuration (PostgreSQL) ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_password
POSTGRES_DB=jobpilot_db
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# --- Redis Configuration ---
REDIS_URL=redis://localhost:6379

# --- Application Configuration ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET="super-secret-session-key-please-change-this-in-production"

# --- Local AI Configuration (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Email Configuration (Nodemailer) ---
# Example for Gmail with OAuth2. For other providers, refer to Nodemailer documentation.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="JobPilot AI <no-reply@jobpilot.ai>"
# For OAuth2, you would need client ID, client secret, refresh token etc.
# EMAIL_CLIENT_ID=...
# EMAIL_CLIENT_SECRET=...
# EMAIL_REFRESH_TOKEN=...

# --- Scheduler Configuration ---
SCHEDULER_TIMEZONE=Asia/Kolkata
DAILY_RUN_TIME=22:00 # 10:00 PM in 24-hour format

# --- JobPilot AI Specific Settings ---
MAX_APPLICATIONS_PER_DAY=5
MIN_MATCH_SCORE=60
ENABLE_AUTOMATION=false # Set to true to enable automated job processing and applications
APPLICATION_MODE=prepare-only # Options: prepare-only, assisted-application, automatic-application

# --- GitHub Integration (if applicable) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ACCESS_TOKEN=
